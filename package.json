{
  "name": "demobro",
  "version": "0.1.0",
  "description": "Generate polished micro-demo videos from a public web app, with optional GitHub context.",
  "private": true,
  "license": "MIT",
  "homepage": "https://www.demobro.video",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hixly/DemoBro.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:worker": "npm run dev --prefix worker",
    "dev:cron": "npm run dev --prefix cron",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "npm test --prefix worker",
    "check": "npm run lint && npm run test && npm run build",
    "brand:logo": "python scripts/make-logo-transparent.py",
    "brand:favicon": "python scripts/make-favicon.py",
    "brand:social-card": "node worker/scripts/render-social-card.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cheerio": "^1.2.0",
    "framer-motion": "^13.0.0",
    "next": "15.5.22",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
