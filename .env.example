# Copy to .env.local for local dev (never commit real values).
# On Railway: set these on the web / worker / cron service variables.

XAI_API_KEY=
# Optional override (default: grok-4.20-0309-non-reasoning)
XAI_MODEL=

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Existing Storage bucket for finished MP4s (default: inbox)
SUPABASE_STORAGE_BUCKET=inbox
# Private Storage bucket for failed/low-confidence traces (default: demobro-diagnostics)
SUPABASE_DIAGNOSTICS_BUCKET=demobro-diagnostics

# Worker video quality. CRF 18 is visually crisp for UI text; lower is larger.
DEMOBRO_X264_CRF=18
DEMOBRO_X264_PRESET=medium
# Keep low on memory-constrained Railway workers.
DEMOBRO_FFMPEG_THREADS=1
# Capture Playwright traces locally; only failed/low-confidence runs are uploaded.
DEMOBRO_CAPTURE_DIAGNOSTICS=true

# HMAC secret for anonymous ip_hash (never store raw IPs)
IP_HASH_SECRET=

# Temporary private beta gate for the web service only.
# Rotating BETA_PASSWORD automatically invalidates existing access cookies.
BETA_GATE_ENABLED=false
BETA_PASSWORD=
