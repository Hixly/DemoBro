# Copy to .env.local for local dev (never commit real values).
# On Railway: set these on the web / worker / cron service variables.

XAI_API_KEY=
# Optional override (default: grok-4.20-0309-non-reasoning)
XAI_MODEL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Existing Storage bucket for finished MP4s (default: inbox)
SUPABASE_STORAGE_BUCKET=inbox

# Worker video quality. CRF 18 is visually crisp for UI text; lower is larger.
DEMOBRO_X264_CRF=18
DEMOBRO_X264_PRESET=medium
# Keep low on memory-constrained Railway workers.
DEMOBRO_FFMPEG_THREADS=1

# HMAC secret for anonymous ip_hash (never store raw IPs)
IP_HASH_SECRET=
